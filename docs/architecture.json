 "cards": [
  {
   "dot": "cyan",
   "title": "Primary path: apply a profile",
   "items": [
    "React UI invokes preview_apply then apply_profile over Tauri IPC",
    "Backend loads the profile from SQLite and asks tars-core for a diff plan",
    "tars-core writes files under safe_join and records each original for rollback",
    "Backend saves the backup JSON and a backup row, rollback restores from it"
   ]
  },
  {
   "dot": "rose",
   "title": "Trust boundaries",
   "items": [
    "Webview has no direct fs or network, only IPC (CSP in tauri.conf.json)",
    "Secrets encrypted in SQLite, master key held in the OS keychain",
    "Scanned config is read, never executed"
   ]
  },
  {
   "dot": "amber",
   "title": "Supporting detail",
   "items": [
    "Pricing refresh on startup then weekly, from LiteLLM on GitHub",
    "Updater checks GitHub releases latest.json",
    "tars-cli shares scanner, plan, backup and storage with the app",
    "Skills, hooks, MCP and profile commands omitted from the overview"
   ]
  }
 ]
